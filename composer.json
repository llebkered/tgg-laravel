{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "appstract/laravel-options": "^5.2",
        "barryvdh/laravel-dompdf": "^2",
        "fideloper/proxy": "^4.4",
        "fruitcake/laravel-cors": "^2.0",
        "guzzlehttp/guzzle": "^7.0.1",
        "hardevine/shoppingcart": "^3.1",
        "intervention/image": "^2.5",
        "intervention/imagecache": "^2.5",
        "laravel/fortify": "^1.6",
        "laravel/framework": "^9.0",
        "laravel/jetstream": "^1.1",
        "laravel/sanctum": "^2.6",
        "laravel/telescope": "^4.3",
        "laravel/tinker": "^2.0",
        "spatie/laravel-honeypot": "^4.3.1",
        "spatie/laravel-medialibrary": "^9.0.0",
        "tcg/voyager": "^1.4",
        "unisharp/laravel-filemanager": "dev-master"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.6",
        "spatie/laravel-ignition": "^1.0" ,
        "fzaninotto/faker": "^1.9.1",
        "laravel/dusk": "^6.25",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^6.1",
        "phpunit/phpunit": "^9.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeds/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "repositories": {
        "hooks": {
            "type": "composer",
            "url": "https://larapack.io"
        },
        "laravel-tinymce-simple-imageupload": {
            "type": "package",
            "package": {
                "name": "llebkered/laravel-tinymce-simple-imageupload",
                "version": "1.3.0",
                "source": {
                    "url": "git@github.com:llebkered/laravel-tinymce-simple-imageupload.git",
                    "type": "git",
                    "reference": "origin/master"
                }
            }
        }
    }
}
