FROM docker.io/library/php:8.4-apache

# Arguments defined in compose.yaml
ARG user
ARG uid

# Install system dependencies and PHP extensions
RUN apt-get update && apt-get install -y \
        git \
        curl \
        zip \
        unzip \
        libpng-dev \
        libjpeg62-turbo-dev \
        libfreetype6-dev \
        libwebp-dev \
        libzip-dev \
        libicu-dev \
    && docker-php-ext-configure gd --with-freetype --with-jpeg --with-webp \
    && docker-php-ext-install pdo_mysql exif pcntl bcmath gd intl zip \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Apache: enable rewrite, listen on 8080 so it can run as a non-root user
RUN a2enmod rewrite \
    && sed -i 's/Listen 80$/Listen 8080/' /etc/apache2/ports.conf \
    && sed -i 's/<VirtualHost \*:80>/<VirtualHost *:8080>/' /etc/apache2/sites-available/000-default.conf

# Composer 2
COPY --from=docker.io/library/composer:2 /usr/bin/composer /usr/bin/composer

# Create system user to run Apache, Composer and Artisan commands
RUN useradd -G www-data,root -u $uid -d /home/$user -m $user

WORKDIR /var/www/html

USER $user

EXPOSE 8080
